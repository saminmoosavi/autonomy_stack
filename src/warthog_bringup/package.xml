<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warthog_bringup</name>
  <version>0.0.0</version>
  <description>Combined Clearpath Nav2, SLAM, and RViz bringup for the Warthog.</description>
  <maintainer email="saminmoosavi@yahoo.com">Samin Moosavi</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>clearpath_nav2_demos</exec_depend>
  <exec_depend>clearpath_viz</exec_depend>
  <exec_depend>lio_sam</exec_depend>
  <exec_depend>liorf_localization</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>waypoint_follower</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
