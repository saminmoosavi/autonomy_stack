<launch>
    <node name="topic_remaper" pkg="bringup_pkg" type="topic_remaper.py" output="screen"/>

    <arg name="project" default="lio_sam"/>
    
    <!-- Parameters -->
    <rosparam file="$(find lio_sam)/config/params.yaml" command="load" />

    <!--- LOAM -->
    <include file="$(find lio_sam)/launch/include/module_loam.launch" />

    <!--- Robot State TF -->
    <include file="$(find lio_sam)/launch/include/module_robot_state_publisher.launch" />

    <!--- Run Navsat -->
    <include file="$(find lio_sam)/launch/include/module_navsat.launch" />

    <!--- Run Rviz-->
    <include file="$(find lio_sam)/launch/include/module_rviz.launch" />



    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server">
        <!-- <param name="resolution" value="0.05" /> -->
        
        <!--common frame id fixed map frame (set to 'map' if SLAM or localization running!) -->
        <param name="frame_id" type="string" value="map" />
        <param name="resolution" type="double" value="0.2" />
        <param name="sensor_model/max_range" type="double" value="250.0" />
        <!-- <param name="latch" type="bool" value="false" /> -->
        <param name="filter_ground" type="bool" value="false" />
        <!-- <param name="ground_filter/distance" type="double" value="0.04" />
        <param name="ground_filter/plane_distance" type="double" value="0.05" />
        <param name="ground_filter/angle" type="double" value="0.15" />
        <param name="compress_map" type="bool" value="true" /> -->
        <!-- <param name="occupancy_min_z" type="double" value="0.0" />
        <param name="occupancy_max_z" type="double" value="2.0" /> -->
        <param name="pointcloud_min_z" type="double" value="-5.0" />
        <param name="pointcloud_max_z" type="double" value="10.0" />
        <param name="publish_free_space" type="bool" value="true" />
        <!-- data source to integrate (PointCloud2) -->
        <remap from="cloud_in" to="/lio_sam/deskew/cloud_deskewed" />
        
    </node>


</launch>
