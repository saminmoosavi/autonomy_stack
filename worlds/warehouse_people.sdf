    <!-- ================= Walking people (animated actors) =================
         Slow walkers (~0.4 m/s) spread across the whole warehouse: north aisle,
         central, east, south, and west zones. Waypoint pose is "x y z R P Y";
         z=1.0 is the actor hip height (lower it if a model sinks/floats). The
         walk.dae skin+animation is fetched from Fuel on first run. Speed is set
         by the time between waypoints (distance / dt); raise the times to slow
         them further. Keep waypoints out of the shelves.                     -->

    <!-- 1) NORTH aisle, E-W (near the robot's northern leg) -->
    <actor name="person_walk_1">
      <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walk"><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop><delay_start>0.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time>  <pose>4 22.5 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>30</time> <pose>-2 22.5 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>34</time> <pose>-2 22.5 1.0 0 0 0</pose></waypoint>
          <waypoint><time>64</time> <pose>4 22.5 1.0 0 0 0</pose></waypoint>
          <waypoint><time>68</time> <pose>4 22.5 1.0 0 0 3.1416</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- 2) CENTRAL-EAST, N-S (along the robot's central route) -->
